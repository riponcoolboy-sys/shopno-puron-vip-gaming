# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Connection URI for permanent database persistence
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token for Instant Deposit/Withdraw Alerts
TELEGRAM_BOT_TOKEN=8622556616:AAEI7JWLWuGenLALK_o8uRBAcvorUHm_XI

# TELEGRAM_CHAT_ID: Telegram Group/Admin Chat ID for Notifications
TELEGRAM_CHAT_ID=8622556616
